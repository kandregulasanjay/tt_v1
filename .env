# CORS Configuration
VITE_CORS_ORIGIN=http://localhost:5173

# HRMS API Configuration
# Development: localhost
# Production: dev.transforma-ai.com
VITE_HRMS_API_URL=http://localhost:4000/api/v1

# Use the /public endpoint to fetch jobs from ALL tenants (published only)
# Regular /jobs endpoint requires X-Tenant-Id header for single tenant
VITE_JOBS_ENDPOINT=/jobs/public

# Enable API debugging to see detailed logs in browser console
VITE_DEBUG_API=true

# Tenant Configuration
# Set to null to display jobs from ALL tenants (published only)
# Set to a specific UUID to display jobs from that tenant only
VITE_TENANT_ID=3dad5f09-1994-4f28-b384-2b9c7e6c3e81

# Application Settings
VITE_APP_NAME=Transforma AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# CORS Settings
VITE_CORS_CREDENTIALS=true

# API Request Settings
VITE_API_TIMEOUT=30000
VITE_API_RETRIES=3
VITE_API_RETRY_DELAY=1000

# Feature Flags
VITE_FEATURE_JOB_SEARCH=true
VITE_FEATURE_JOB_FILTERING=true
VITE_FEATURE_APPLICATION_SUBMISSION=true
VITE_FEATURE_RESUME_UPLOAD=true

# API Endpoints
VITE_HEALTH_ENDPOINT=/health
VITE_APPLY_ENDPOINT=/apply

===================== END OF DEVELOPMENT VARIABLES ==================

##################### PRODUCTION ENVIRONMENT VARIABLES #####################
# Uncomment and update these values when deploying to production
# You can also set these in your deployment platform (AWS, Vercel, Netlify, etc.)

# CORS Configuration for S3 Deployment
# VITE_CORS_ORIGIN=https://transforma-ai.com

# HRMS API Configuration for Production
# VITE_HRMS_API_URL=https://demo-hcm.roots-cloud.com/api/v1

# Jobs Endpoint for Production
# VITE_JOBS_ENDPOINT=/jobs/public

# Disable debugging in production
# VITE_DEBUG_API=false

# Tenant Configuration for Production
# Set to a specific tenant UUID to show only that tenant's jobs
# VITE_TENANT_ID=3dad5f09-1994-4f28-b384-2b9c7e6c3e81

# Application Settings for Production
# VITE_APP_NAME=Transforma AI
# VITE_APP_VERSION=1.0.0
# VITE_APP_ENVIRONMENT=production

# CORS Settings for Production
# VITE_CORS_CREDENTIALS=true

# API Request Settings for Production (increased for reliability)
# VITE_API_TIMEOUT=45000
# VITE_API_RETRIES=5
# VITE_API_RETRY_DELAY=2000

# Feature Flags for Production
# VITE_FEATURE_JOB_SEARCH=true
# VITE_FEATURE_JOB_FILTERING=true
# VITE_FEATURE_APPLICATION_SUBMISSION=true
# VITE_FEATURE_RESUME_UPLOAD=true

# API Endpoints for Production
# VITE_HEALTH_ENDPOINT=/health
# VITE_APPLY_ENDPOINT=/apply

==================== END OF FILE ==================
